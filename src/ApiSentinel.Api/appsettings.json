{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ApiSentinel;User Id=sa;TrustServerCertificate=True;Encrypt=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Monitoring": {
    "ContractAnalysis": {
      "MaxDepth": 10,
      "MaxFields": 500
    },
    "HttpExecution": {
      "MaxResponseBytes": 1048576,
      "ResponseBodySnippetMaxChars": 4096,
      "MaxRedirects": 3
    },
    "NetworkSecurity": {
      "DevelopmentInternalHosts": []
    }
  },
  "AllowedHosts": "*"
}
